diff --git a/Plugins/ProlineRml/Source/RmlUiCore/RmlUi/Source/Core/ElementAnimation.cpp b/Plugins/ProlineRml/Source/RmlUiCore/RmlUi/Source/Core/ElementAnimation.cpp
index 1da53683..8e7a1e46 100644
--- a/Plugins/ProlineRml/Source/RmlUiCore/RmlUi/Source/Core/ElementAnimation.cpp
+++ b/Plugins/ProlineRml/Source/RmlUiCore/RmlUi/Source/Core/ElementAnimation.cpp
@@ -746,7 +746,21 @@ Property ElementAnimation::UpdateAndGetProperty(double world_time, Element& elem
 {
 	float dt = float(world_time - last_update_world_time);
 	if (keys.size() < 2 || animation_complete || dt <= 0.0f)
+	{
+		// Proline patch 0001: an 'animation'-property animation still waiting out its delay previews the
+		// first keyframe once (CSS animation-fill-mode: backwards), instead of showing the base rule for
+		// the whole delay. Key 0 is either the resolved 0% keyframe or, if none was authored, the
+		// element's value when the animation started (see Element::HandleAnimationProperty), so it is
+		// already the correct "before start" value. Applied once (delay_fill_applied) since SetProperty
+		// dirties layout; transitions and Element::Animate (ElementAnimationOrigin::User) keep the old
+		// silent wait.
+		if (!animation_complete && dt <= 0.0f && keys.size() >= 2 && origin == ElementAnimationOrigin::Animation && !delay_fill_applied)
+		{
+			delay_fill_applied = true;
+			return keys[0].property;
+		}
 		return Property{};
+	}
 
 	dt = Math::Min(dt, 0.1f);
 
diff --git a/Plugins/ProlineRml/Source/RmlUiCore/RmlUi/Source/Core/ElementAnimation.h b/Plugins/ProlineRml/Source/RmlUiCore/RmlUi/Source/Core/ElementAnimation.h
