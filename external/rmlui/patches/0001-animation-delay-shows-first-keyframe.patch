+++ b/Plugins/ProlineRml/Source/RmlUiCore/RmlUi/Source/Core/ElementAnimation.h
@@ -37,6 +37,11 @@ private:
 	bool animation_complete = false;
 	ElementAnimationOrigin origin = ElementAnimationOrigin::User;
 
+	// Proline patch 0001: set once UpdateAndGetProperty has applied the first keyframe as a preview
+	// while an 'animation'-property delay is still elapsing, so the preview is only ever applied once
+	// (SetProperty dirties layout) and not re-applied every frame until the delay ends.
+	bool delay_fill_applied = false;
+
 	bool InternalAddKey(float time, const Property& property, Element& element, Tween tween);
 
 	float GetInterpolationFactorAndKeys(int* out_key0, int* out_key1) const;
