<rml><head><title>Native pixel checks</title><style>
body { width: 100%; height: 100%; margin: 0; font-family: Source Sans Pro; color: white; }
div, img { position: absolute; }
#red { left: 10px; top: 10px; width: 40px; height: 40px; background-color: #ff0000; }
#alpha { left: 70px; top: 10px; width: 40px; height: 40px; background-color: #00ff0080; }
#clip { left: 10px; top: 100px; width: 50px; height: 40px; overflow: hidden; clip: always; }
#overflow { left: 0; top: 0; width: 100px; height: 40px; background-color: #ff0000; }
#moved { left: 200px; top: 120px; width: 20px; height: 20px; background-color: #ffff00; transform: translateX(30px); }
#type { left: 10px; top: 170px; width: 270px; font-size: 24px; }
img { left: 180px; top: 10px; width: 80px; height: 80px; }
</style></head><body><div id="red" /><div id="alpha" /><div id="clip"><div id="overflow" /></div><div id="moved" /><img src="images/probe.tga" /><div id="type">FREETYPE / 012345</div></body></rml>
