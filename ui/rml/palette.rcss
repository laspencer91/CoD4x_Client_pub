body { width: 100%; height: 100%; margin: 0; background-color: #101813e8; overflow: auto; }
.palette { width: 1160dp; max-width: 94%; margin: 24dp auto; }
.header { display: flex; justify-content: space-between; align-items: center; padding-bottom: 14dp; border-bottom: 1dp var(--rule); }
h1 { font-size: 36dp; font-weight: normal; letter-spacing: 3dp; margin: 4dp 0 0; }
.build-tag { text-align: right; font-size: 13dp; line-height: 1.5; letter-spacing: 2dp; }
.lead { font-size: 16dp; color: var(--muted); margin: 15dp 0 22dp; }
.samples { display: flex; flex-wrap: wrap; }
.sample { box-sizing: border-box; width: 33.333%; padding: 0 12dp 20dp 0; }
.label { font-size: 12dp; letter-spacing: 2dp; color: var(--accent); margin-bottom: 10dp; }
.preview { position: relative; box-sizing: border-box; height: 142dp; padding: 25dp 20dp; background-color: #172019; overflow: hidden; clip: always; }
.large { font-size: 25dp; margin: 5dp 0; letter-spacing: 1dp; }
.recipe { font-size: 13dp; margin-top: 10dp; }
.note { font-size: 12dp; color: var(--muted); margin-top: 5dp; height: 28dp; }
.faded { background-color: transparent; decorator: soft-fade(#172019ee 0.08 0.04 0.08 0.04); }
.tactical-frame { padding: 52dp 28dp 0; }
.tactical-frame .control { width: 100%; margin: 0; }
.signal-screen { background-color: #1d2a20; }
.sweep-track { position: absolute; left: 20dp; right: 20dp; bottom: 26dp; height: 1dp; overflow: hidden; clip: always; background-color: #425139; }
.sweep { width: 72dp; height: 1dp; background-color: var(--accent); }
.playing .sweep { animation: 1.2s linear-in-out signal-sweep; }
@keyframes signal-sweep { from { transform: translateX(-72dp); } to { transform: translateX(350dp); } }
.glitch-copy { position: absolute; left: 20dp; top: 44dp; font-size: 26dp; letter-spacing: 1dp; }
.red { color: #db7767; opacity: 0; }.cyan { color: #73c4b5; opacity: 0; }.foreground { color: var(--ink); }
.signal-caption { position: absolute; left: 20dp; bottom: 25dp; font-size: 10dp; color: var(--muted); letter-spacing: 1dp; }
.states { padding-top: 18dp; }.states span { display: inline-block; font-size: 22dp; margin-right: 18dp; }.states .control { width: 100%; margin-top: 16dp; }
.toolbar { display: flex; align-items: center; padding: 15dp 0; border-top: 1dp var(--rule); border-bottom: 1dp var(--rule); }
.toolbar .control { width: 190dp; margin: 0; }.toolbar #close { width: 110dp; }.feedback { flex-grow: 1; padding: 0 20dp; color: var(--muted); font-size: 14dp; }
.footer { font-size: 11dp; margin-top: 18dp; }
@media (max-width: 1000dp) { .sample { width: 50%; } }
.motion-heading { display: flex; align-items: center; justify-content: space-between; margin-bottom: 20dp; }
.motion-heading input.control { width: 190dp; margin: 0; height: 34dp; padding: 6dp 12dp; font-size: 13dp; }
.motion-effects .preview { background-color: #252528; }
.motion-effects .sample { width: 50%; }
.frame-stage { padding: 26dp 20dp; }
.row-stage { padding-top: 17dp; }
.row-stage .stagger-row { padding: 5dp 8dp; margin-bottom: 3dp; font-size: 15dp; border-left: 1dp var(--accent); background-color: #ffffff08; }
.stagger-row span { color: var(--muted); margin-right: 15dp; }
.decrypt-demo .preview { background-color: #252528; height: 150dp; }
.decrypt-demo .large { margin: 8dp 0 10dp; }
.decrypt-numbers { color: var(--muted); font-size: 15dp; letter-spacing: 2dp; }
.decrypt-controls { display: flex; }
.decrypt-controls input.control { width: 180dp; margin: 10dp 12dp 0 0; height: 34dp; padding: 6dp 12dp; font-size: 12dp; }

.hardware-toggle-example { width: 300dp; height: 32dp; position: relative; font-size: 15dp; }.hardware-toggle-example ui-toggle { position: absolute; right: 0; top: 0; }.hardware-armor-example { width: 300dp; margin-top: 24dp; }
